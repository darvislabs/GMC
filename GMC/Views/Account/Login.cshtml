@model GMC.Models.GMC.LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = null; // Use a standalone layout for the login screen
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMC Login</title>
    <partial name="_InterFont" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons for input icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
            background-color: #ffffff;
        }

        .split-layout {
            display: flex;
            height: 100vh;
        }

        /* Left Side Panel */
        .split-left {
            flex: 1;
            background: linear-gradient(rgba(0, 51, 102, 0.4), rgba(0, 51, 102, 0.7)), url('/Images/login_building_bg.png') no-repeat center center;
            background-size: cover;
            position: relative;
            display: none; /* Hide on small screens */
            position: relative;
        }

        @@media (min-width: 768px) {
            .split-left {
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                padding: 4rem;
            }
        }

        .hero-text {
            color: #ffffff;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .hero-subtext {
            color: #e0e0e0;
            font-size: 1.2rem;
            font-weight: 400;
            margin-bottom: 2rem;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }

        /* Right Side Panel */
        .split-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            background-color: #ffffff;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
        }

        .login-header h1 {
            font-weight: 800;
            color: #111;
            margin-bottom: 0.5rem;
            font-size: 2.2rem;
        }

        .login-header p {
            color: #666;
            margin-bottom: 2.5rem;
            font-size: 1rem;
        }

        .form-label {
            font-weight: 600;
            color: #333;
            font-size: 0.9rem;
            margin-bottom: 0.4rem;
        }

        .form-control-icon-wrapper {
            position: relative;
        }

        .form-control-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 1.1rem;
        }

        .form-control-with-icon {
            padding-left: 2.8rem;
            height: 48px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 0.95rem;
        }
        
        .form-control-with-icon:focus {
            border-color: #0b5ed7;
            box-shadow: 0 0 0 0.25rem rgba(11, 94, 215, 0.1);
        }

        .forgot-password {
            float: right;
            font-size: 0.85rem;
            color: #0b5ed7;
            text-decoration: none;
            font-weight: 500;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .btn-signin {
            height: 48px;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 6px;
            background-color: #0d6efd;
            border: none;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            width: 100%;
            color: white;
            transition: all 0.2s ease-in-out;
            margin-top: 1.5rem;
        }

        .btn-signin:hover {
            background-color: #0b5ed7;
            color: white;
            transform: translateY(-1px);
        }

        .create-account-wrap {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.95rem;
            color: #666;
        }

        .create-account-link {
            color: #0b5ed7;
            font-weight: 600;
            text-decoration: none;
        }

        .create-account-link:hover {
            text-decoration: underline;
        }
        
        .bg-error {
            background-color: #f8d7da;
            color: #842029;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            border: 1px solid #f5c2c7;
        }
    </style>
</head>
<body>

    <div class="split-layout">
        
        <!-- Left Side: Image Map -->
        <div class="split-left">
            <div>
                <div class="hero-text">GMC Platform</div>
                <div class="hero-subtext">Streamline your Group Medical Coverage data processing</div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="split-right">
            <div class="login-container">
                
                <div class="login-header">
                    <h1>Welcome back</h1>
                    <p>Sign in to continue to your dashboard</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-error">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post">
                    
                    <!-- Username (Email) Field -->
                    <div class="mb-4">
                        <label asp-for="Username" class="form-label">Email address</label>
                        <div class="form-control-icon-wrapper">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Username" class="form-control form-control-with-icon" placeholder="name@company.com" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label mb-0">Password</label>
                            <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-password">Forgot password?</a>
                        </div>
                        <div class="form-control-icon-wrapper">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password" type="password" class="form-control form-control-with-icon" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-signin">
                        Sign in <i class="bi bi-arrow-right"></i>
                    </button>
                    
                </form>

                <div class="create-account-wrap">
                    Don't have an account? <a asp-controller="Account" asp-action="UserRegistration" class="create-account-link">Create account</a>
                </div>

            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>
