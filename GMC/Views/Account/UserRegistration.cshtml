@model GMC.Models.GMC.UserRegistrationModel

@{
    ViewData["Title"] = "Create account";
    Layout = null; // Use a standalone layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - GMC</title>
    <partial name="_InterFont" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
            background-color: #ffffff;
        }

        .split-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Left Side Panel */
        .split-left {
            flex: 1;
            background: url('/GMC/Images/register_geometric_bg.png') no-repeat center center;
            background-size: cover;
            position: relative;
            display: none; /* Hide on small screens */
        }

        @@media (min-width: 992px) {
            .split-left {
                display: block;
            }
        }

        /* Right Side Panel */
        .split-right {
            flex: 1.2;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem 2rem;
            background-color: #ffffff;
            overflow-y: auto;
        }

        .register-container {
            width: 100%;
            max-width: 550px; /* Slightly wider to accommodate side-by-side fields nicely */
            margin: auto;
        }

        .register-header h1 {
            font-weight: 800;
            color: #111;
            margin-bottom: 0.5rem;
            font-size: 2.2rem;
        }

        .register-header p {
            color: #666;
            margin-bottom: 2.5rem;
            font-size: 1rem;
        }

        .form-label {
            font-weight: 600;
            color: #333;
            font-size: 0.9rem;
            margin-bottom: 0.4rem;
        }

        .form-control-icon-wrapper {
            position: relative;
        }

        .form-control-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 1.1rem;
        }

        .form-control-with-icon {
            padding-left: 2.8rem;
            height: 48px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 0.95rem;
        }
        
        /* standard height for non-icon fields to match */
        .form-control-standard {
            height: 48px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 0.95rem;
        }
        
        .form-select-standard {
            height: 48px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 0.95rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: #0b5ed7;
            box-shadow: 0 0 0 0.25rem rgba(11, 94, 215, 0.1);
        }

        .btn-register {
            height: 48px;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 6px;
            background-color: #0d6efd;
            border: none;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            width: 100%;
            color: white;
            transition: all 0.2s ease-in-out;
            margin-top: 1.5rem;
        }

        .btn-register:hover {
            background-color: #0b5ed7;
            color: white;
            transform: translateY(-1px);
        }

        .login-wrap {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.95rem;
            color: #666;
        }

        .login-link {
            color: #0b5ed7;
            font-weight: 600;
            text-decoration: none;
        }

        .login-link:hover {
            text-decoration: underline;
        }
        
        .bg-success-alert {
            background-color: #d1e7dd;
            color: #0f5132;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            border: 1px solid #badbcc;
            font-weight: 500;
        }

        .bg-error {
            background-color: #f8d7da;
            color: #842029;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            border: 1px solid #f5c2c7;
        }
        
        .password-helper {
            font-size: 0.75rem;
            color: #888;
            margin-top: 5px;
            display: block;
        }
    </style>
</head>
<body>

    <div class="split-layout">
        
        <!-- Left Side: Graphic -->
        <div class="split-left"></div>

        <!-- Right Side: Register Form -->
        <div class="split-right">
            <div class="register-container">
                
                <div class="register-header">
                    <h1>Create account</h1>
                    <p>Get started with your GMC journey</p>
                </div>

                @if (ViewBag.Success != null)
                {
                    <div class="bg-success-alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Success
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="bg-error">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="UserRegistration" method="post">
                    
                    <div class="row">
                        <!-- Full Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Full name</label>
                            <div class="form-control-icon-wrapper">
                                <i class="bi bi-person"></i>
                                <input asp-for="Name" class="form-control form-control-with-icon" placeholder="John Doe" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Email Address -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="emailid" class="form-label">Email address</label>
                            <div class="form-control-icon-wrapper">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="emailid" class="form-control form-control-with-icon" placeholder="name@company.com" required />
                            </div>
                            <span asp-validation-for="emailid" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Login Username -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Username" class="form-label">Username</label>
                            <div class="form-control-icon-wrapper">
                                <i class="bi bi-at"></i>
                                <input asp-for="Username" class="form-control form-control-with-icon" placeholder="johndoe123" required />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="form-control-icon-wrapper">
                                <i class="bi bi-lock"></i>
                                <input asp-for="Password" type="password" class="form-control form-control-with-icon" placeholder="••••••••" required />
                            </div>
                            <span class="password-helper">Minimum 6 characters</span>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Mobile -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="mobile" class="form-label">Mobile</label>
                            <div class="form-control-icon-wrapper">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="mobile" class="form-control form-control-with-icon" placeholder="+1 (555) 000-0000" />
                            </div>
                            <span asp-validation-for="mobile" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="usertype" class="form-label">Role</label>
                            <select asp-for="usertype" class="form-select form-select-standard" asp-items="ViewBag.Roles" required>
                                <option value="">-- Select Role --</option>
                            </select>
                            <span asp-validation-for="usertype" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="mb-4">
                        <label asp-for="address" class="form-label">Address</label>
                        <textarea asp-for="address" class="form-control" rows="2" placeholder="Full residential or office address" style="border-radius: 6px; font-size: 0.95rem;"></textarea>
                        <span asp-validation-for="address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-register">
                        Create account <i class="bi bi-arrow-right"></i>
                    </button>
                    
                </form>

                <div class="login-wrap">
                    Already have an account? <a asp-controller="Account" asp-action="Login" class="login-link">Sign in</a>
                </div>

            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>
