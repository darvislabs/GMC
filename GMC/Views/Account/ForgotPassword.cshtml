@model GMC.Models.GMC.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null; // Standalone layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - GMC</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <partial name="_InterFont" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/opex-theme.css" asp-append-version="true" />
    <script src="~/js/opex-theme.js" asp-append-version="true"></script>

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
            background-color: var(--ox-canvas, #F5F7FA);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-card {
            background: var(--ox-surface, #FFFFFF);
            border: 1px solid var(--ox-border, rgba(15,23,42,0.09));
            box-shadow: var(--ox-shadow-card, 0 4px 24px rgba(0,0,0,0.06));
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            width: 100%;
            max-width: 450px;
            padding: 3rem;
        }

        .auth-header h1 {
            font-weight: 800;
            color: var(--ox-text, #0F172A);
            margin-bottom: 0.5rem;
            font-size: 2rem;
        }

        .auth-header p {
            color: var(--ox-text-2, #64748B);
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 2rem;
            color: var(--ox-text-3, #555);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .back-link:hover {
            color: var(--ox-text, #0F172A);
        }

        .form-label {
            font-weight: 600;
            color: var(--ox-text-2, #333);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .form-control-icon-wrapper {
            position: relative;
        }

        .form-control-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 1.1rem;
        }

        .form-control-with-icon {
            padding-left: 2.8rem;
            height: 48px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 0.95rem;
        }
        
        .form-control:focus {
            border-color: #1B5EFF;
            box-shadow: 0 0 0 0.25rem rgba(27, 94, 255, 0.18);
        }

        .btn-primary-auth {
            height: 48px;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 6px;
            background-color: #1B5EFF;
            border: none;
            width: 100%;
            color: white;
            transition: all 0.2s ease-in-out;
            margin-top: 1.5rem;
        }

        .btn-primary-auth:hover {
            background-color: #0047E6;
        }

        .bg-error {
            background-color: rgba(255, 59, 48, 0.08);
            color: #FF7A70;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            border: 1px solid rgba(255, 59, 48, 0.25);
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <a asp-controller="Account" asp-action="Login" class="back-link">
            <i class="bi bi-arrow-left me-2"></i> Back to login
        </a>

        <div class="ox-logo" style="width: 24px; height: 20px; display: inline-flex; margin-bottom: 1rem;"><partial name="_OxLogo" /></div>
        <div class="auth-header">
            <h1>Forgot password?</h1>
            <p>Enter your email and we'll send you a reset link</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-error">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label asp-for="EmailAddress" class="form-label">Email address</label>
                <div class="form-control-icon-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="EmailAddress" class="form-control form-control-with-icon" placeholder="name@company.com" required />
                </div>
                <span asp-validation-for="EmailAddress" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary-auth">
                Send reset link
            </button>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>
