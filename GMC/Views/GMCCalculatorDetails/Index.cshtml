@section Scripts {
<script src="~/js/jquery.dataTables.min.js" asp-append-version="true"></script>
<script src="~/js/dataTables.fixedHeader.min.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {
        $("#divLoading").hide();
        $("#idmaster").hide();
        $("#tbl").hide();
        $('#idpolicy').prop('disabled', true)
        $('#idpName').prop('disabled', true)
        $('#btnSearch').prop('disabled', true)
    });
    function checkDatatable() {
        if ($.fn.dataTable.isDataTable('#tblTable')) {
            table = $('#tblTable').DataTable();
            table.destroy();
        }
    }
</script>
<script>
    $("#drpbussi").change(function () {
        //debugger
        // var e = document.getElementById("drpbussi");

        var value = $("#drpbussi option:selected").text()
        
        //debugger
        if (value == "Rollover") {
            $('#idpolicy').prop('disabled', false)
            $('#idpName').prop('disabled', false)
            $('#btnSearch').prop('disabled', false)
            $("#tbl").show();
            getPolicyData(value);
        }
        else if (value == "Fresh") {
            $('#idpolicy').prop('disabled', false)
            $('#idpName').prop('disabled', false)
            $('#btnSearch').prop('disabled', false)
            $("#tbl").show();
            getPolicyData(value);
        }
        else if (value == "Renewal") {
             $('#idpolicy').prop('disabled', false)
            $('#idpName').prop('disabled', false)
            $('#btnSearch').prop('disabled', false)
            $("#tbl").show();
            getPolicyData(value);
        }
       
    });


    function getPolicyData(value) {
        $("#divLoading").show();
        checkDatatable();
        var value = $("#drpbussi option:selected").text()
        $("#tblTable").DataTable({
            "scrollX": true,

            "orderCellsTop": true,
            "autoWidth": true,
            "scrollCollapse": true,
            "fixedHeader": true,
            "select": true,
            "processing": true, // for show progress bar
            "serverSide": false, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": true, // for disable multiple column at once
            "responsive": true,
            "order": [],
            "language":
            {
                "processing": "<img style='width:50px; height:50px;' src='../../../Images/icons8-spinner.gif' />",
            },
            "ajax": {
                "url": "@Url.Action("getGMCPremuiumDetails")",//"/BIMS/VendorCreation/getVendorDetails",
                "data": { types: value},
                "type": "POST",
                "datatype": "json",
                "complete": function (response) {

                }

            },
            "columns": [
                {
                    data: null, render: function (data, type, row) {
                      
                        if (data.status == "Completed") {
                            return "<a  class='disabled' id='approp' href='#'  onclick=ApproveData('" + $.trim(row.PolicyNo_unique) + "','Completed'); title='Approve' ><span class='btn-success btn-sm rounded-0'>Completed</span></a>";
                        }
                        else {
                            return "<a  id='approp' href='#'  onclick=ApproveData('" + $.trim(row.PolicyNo_unique) + "','Pending'); title='Approve' ><span class='btn-warning btn-sm rounded-0'>Pending</span></a>";

                        }
                    }
                },

                { "data": "PolicyNo_unique", "name": "PolicyNo_unique", "autoWidth": true },
                {
                    "data": "PolicyName", "name": "PolicyName", "autoWidth": true

                },
                {
                    "data": "created_by", "name": "created_by", "autoWidth": true

                },
                { "data": "insert_date", "name": "insert_date", "autoWidth": true },


            ],
            initComplete: function () {

                var api = this.api();
                // For each column
                api.columns().eq(0).each(function (colIdx) {
                    // Set the header cell to contain the input element
                    var cell = $('.filters th').eq($(api.column(colIdx).header()).index());

                    var title = $(cell).text();
                    if (title != "") {
                        $(cell).html('<input type="text" placeholder="' + title + '" />');
                    }

                    // On every keypress in this input
                    $('input', $('.filters th').eq($(api.column(colIdx).header()).index()))
                        .off('keyup change')
                        .on('keyup change', function (e) {
                            e.stopPropagation();
                            // Get the search value
                            $(this).attr('title', $(this).val());
                            var regexr = '({search})'; //$(this).parents('th').find('select').val();
                            var cursorPosition = this.selectionStart;
                            // Search the column for that value
                            api
                                .column(colIdx)
                                .search((this.value != '') ? regexr.replace('{search}', '(((' + this.value + ')))') : '', this.value != '', this.value == '')
                                .draw();
                            $(this).focus()[0].setSelectionRange(cursorPosition, cursorPosition);
                        });
                });
                
                $('th').find('input:text').each(function () {
                    $(this).val('');
                }
                );

            }

        });
        $("#divLoading").hide();
    }
    function ApproveData(id, strid) {
        debugger
        var value = $("#drpbussi option:selected").text()
        if(value=="Rollover")
        {
            if (strid == "Completed")
            {
                window.location.href = "@Url.Action("GMCCalculatorpremium")/?policyno=" + id;
            }
            else{
                window.location.href = "@Url.Action("GMCCalculatorpremium")/?policyno=" + id;
            }
            
        }
        else if (value == "Renewal") {
            if (strid == "Completed") {
                window.location.href = "@Url.Action("GMC_Renewal_CalculatorPremium")/?policyno=" + id;
            }
            else {
                window.location.href = "@Url.Action("GMC_Renewal_CalculatorPremium")/?policyno=" + id;
            }

        }
    }

</script>
}
