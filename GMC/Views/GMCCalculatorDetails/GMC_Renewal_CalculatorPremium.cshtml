                    {
                        <div class="table-responsive">
                        <table id="tableVersion" class="table table-striped table-bordered nowrap hover">
                            <thead>
                                <tr>
                                    <th>Version Number</th>
                                    <th>Policy No</th>
                                    <th>Version Date</th>
                                    <th>Edit</th>
                                    <th>Download</th>
                                    <th>Download Summary</th>
                                    <th>UW Remarks</th>
                                    <th>Burn Cost Premium</th>
                                    <th>Enrollment Premium</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow item in Model.dtVersion.Rows)
                                {
                                    <tr>
                                        <td>@item["VersionNumber"].ToString()</td>
                                        <td>@item["policyno"].ToString()</td>
                                        <td>@item["Version_Date"].ToString()</td>
                                        <td><input type="button" class="btn btn-success  btn-sm row-btn" value="Edit" /></td>
                                        <td><input type="button" class="btn btn-secondary  btn-sm row-btn1" value="Download" /></td>
                                        <td><input class="btn btn-secondary btn-sm row-btn2" value="Download Summary"/></td>
                                        <td>@item["UW_remarks"].ToString()</td>
                                        <td>@item["BurningLoading"].ToString()</td>
                                        <td>@item["EnrollmentLoading"].ToString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    
                    
                    
                    <p style="padding:2px;background-color:maroon;color:white;margin-left: -29px;"><strong><b>Final Premium Closed With</b></strong></p>
                    <div class="row">
                        <div class="form-group col-3" id="drpBranchDIV">
                            <label asp-for="versionNo" for="inputEmail4">Version</label><br />
                            <select id="drpversion" class="form-control" asp-for="versionNo" asp-items="@(new SelectList(Model.versionDatalist, "VersionNumber", "VersionNumber"))">
                                <option>--Select--</option>
                            </select>
                            <input type="hidden" asp-for="versionNo"  />
                            <span asp-validation-for="versionNo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-2">
                            <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Index", "GMCCalculatorDetails")'">Back</button>
                        </div>
                        <div class="form-group col-3">
                            <button type="button" class="btn btn-outline-primary"
                                    onclick="location.href='@Url.Action("TrendAnalysis", "GMCCalculatorDetails")' + '?policyno=' + encodeURIComponent($('#txtPolicyNo').val())">
                                <i class="bi bi-graph-up-arrow"></i> Trend Analysis
                            </button>
                        </div>
                    </div>
                   </form>
                   <span id="iderror" class="text-danger" style="font-size:inherit.5em;margin-top:1em;margin-left:1em;font-weight:bold;"></span>
                   </div>
                   </div>
                   </div>
                   </div>
</div>

@section Scripts {
<script src="~/js/jquery.dataTables.min.js" asp-append-version="true"></script>
<script src="~/js/dataTables.fixedHeader.min.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {
        $("#divLoading").hide();
        $("#idmaster").hide();
        $("#tblSt").hide();
        $("#tblFactor").hide();
        $("#tblBurn").hide();
        $('#idpolicy').prop('disabled', true)
        $('#idpName').prop('disabled', true)
        $('#btnSearch').prop('disabled', true)
    });
    function checkDatatable() {
        if ($.fn.dataTable.isDataTable('#tblTable')) {
            table = $('#tblTable').DataTable();
            table.destroy();
        }
    }
</script>
<script>
    $(document).ready(function () {
 if ($.fn.dataTable.isDataTable('#tableVersion')) {
            $('#tableVersion').DataTable().destroy();

          }

    $('#tableVersion').DataTable({
        destroy: true,
        scrollX: true,
        paging: false,
        ordering: false,
        filter: false,
        responsive: true,

    });
        $('#tblBurn').DataTable({
            destroy: true,
            scrollX: true,
            paging: false,
            ordering: false,
            filter: false,
            responsive: true,

        });
    getBurnCostDetails();
    
});
    function DownloadVersionDetails(policyNo,versionNo) {
        $("#divLoading").show();
        $.ajax({
            url: '@Url.Action("downloadRenewalVersionDetailsData")',
            data: { Policyno: policyNo, VersionNumber: versionNo },
            type: 'POST',
            // contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (result) {
                debugger
                if (result.excelfileName != null) {
                    window.location.href = "@Url.RouteUrl(new
                    {
                        Controller = "GMCCalculatorDetails",
                        Action = "DownloadDataFile"
                        })/?filename=" + result.excelfileName;
                    $("#divLoading").hide();
                   
                }
                else {
                    $("#iderror").html(result.error);
                    $("#divLoading").hide();

                    
                }
            },
           
            error: function (response) {
                $("#divLoading").hide();

                $("#dropError").html(response);
            }
        });
    }
function SaveVersion()
{
    $("#divLoading").show();
        var myData = $('#theForm1').serialize();
        var policyno=$("#txtPolicyNo").val();
        $.ajax({
            url: '@Url.Action("SaveData")',
            data: myData,
            type: 'POST',
            // contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (result) {
                debugger
                if (result != null) {
                    var dataObj = JSON.parse(result);
                    if(dataObj.data.version!="") {
                        
                        SaveBurnData(dataObj.data.version);
                        SaveFactorData(dataObj.data.version);
                        SaveSTData(dataObj.data.version);
                        $("#divLoading").hide();
                        
                        
                    }
                    else{
                        $("#divLoading").hide();
                       
                    
                    }
                    
                    
                    


                }
                else {
                    $("#iderror").html(result.error);
                    $("#divLoading").hide();

                    return;
                }
            },

            error: function (response) {
                $("#divLoading").hide();

                $("#drpError").html(response);
            }
        });
        
        //window.location.href = "@Url.Action("GMCCalculatorpremium")/?policyno=" + policyno;
        $("#iderror").html("Version Data Saved");
}

function SaveBurnData(versionNo)
{
    debugger
    var table = $('#tblBurn').DataTable();
        var rowNodes = table.rows().nodes().toArray();
        var dataArray = [];

        table.rows().every(function () {
            var rowData = [];
            var $row = $(this.node()); // Get the DOM element of the row

            // Get text data from the first two cells
            rowData.push($row.find('td:nth-child(1)').text()); // Name
            // Get the value from the textbox
            rowData.push($row.find('td:nth-child(2)').text()); // Textbox value
            rowData.push($row.find('td:nth-child(3)').text()); // Textbox value
            rowData.push($row.find('td:nth-child(4) input').val()); // Name
            // Add row data to the main array
            dataArray.push(rowData);
        });
        $.ajax({
            url: '@Url.Action("SaveBurnData")',
            data: { BData: dataArray, versionNo: versionNo },
            type: 'POST',
            // contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (result) {
                debugger
                if (result != null) {
                }
            }
        });
}
