@model GMC.Models.GMC.GMCCalculatorDetailsModel
@using GMC.Models.GMC
@using System.Data
@{
    ViewData["Title"] = "GMC Renewal Calculator Premium";
    Layout = "_LayoutModern";
}

@section Styles {
<link href="~/css/jquery.dataTables.min.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/fixedHeader.dataTables.min.css" rel="stylesheet" asp-append-version="true" />
<style>
    #divLoading {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, 0.45);
    }

    /* Legacy maroon section bars → modern section headers */
    .gmc-calc-page p[style*="maroon"] {
        background: var(--gmc-primary) !important;
        color: #fff !important;
        margin: 26px 0 14px !important;
        padding: 8px 14px !important;
        border-radius: 8px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .gmc-calc-page .row { margin-bottom: 0 !important; }
    .gmc-calc-page .form-group { margin-bottom: 1rem; }
    .gmc-calc-page label { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
    .gmc-calc-page .form-control { font-size: 14px; }

    .gmc-calc-page .table thead th {
        background: #f1f5f9;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        vertical-align: middle;
    }

    .gmc-calc-page .disabledbutton {
        pointer-events: none;
        opacity: 0.4;
    }
</style>
}

<div class="gmc-calc-page">
