                        </div>
                        <div class="form-group col-3" id="idpolicy">
                            <label asp-for="AvgLives" for="inputEmail4"><b>Avg Lives</b></label><br />
                            <input type="text" asp-for="AvgLives" class="form-control" id="txtAvgLives" />
                            <span asp-validation-for="AvgLives" class="text-danger"></span>
                            <input type="hidden" asp-for="AvgLives" />

                        </div>
                        <div class="form-group col-3" id="idpolicy">
                            <label asp-for="PolicyServiceDays" for="inputEmail4"><b>Policy Service Days</b></label><br />
                            <input type="text" asp-for="PolicyServiceDays" class="form-control" id="txtPolicyServiceDays" />
