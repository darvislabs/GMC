                            </tr>
                        </thead>
                        <tbody id="tbodyFactor">
                        </tbody>
                    </table>
                    </div>
                    <div class="row">
                        <div class="form-group col-3" id="idpolicy">
                            <label asp-for="UWRemarks" for="inputEmail4"><b>UW Remarks</b></label><br />
                            <input type="text" asp-for="UWRemarks" class="form-control" id="txtUWRemarks" />
