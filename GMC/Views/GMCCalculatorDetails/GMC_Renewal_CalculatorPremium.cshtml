                            <label for="inputEmail4"><b>Upload revised Lives data.</b></label>
                            <input type="file" id="fileUpload1" asp-for="myFile1" accept=".xls,.xlsx" class="form-control" />
                            <span id="fileupploaderror" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-6" id="idpolicy">
