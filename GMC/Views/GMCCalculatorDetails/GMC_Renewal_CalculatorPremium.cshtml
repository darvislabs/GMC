                            </tr>
                        </thead>
                        <tbody id="tbodyBurn">

                        </tbody>
                    </table>
                    </div>
                    <p style="padding:2px;background-color:maroon;color:white;margin-left: -29px;"><strong><b>Endrollment Premium Loading</b></strong></p>

                    @*<p style="padding:2px;background-color:maroon;color:white;margin-left: -29px;"><strong><b>Standerd Loading </b></strong></p>*@
                    <div class="table-responsive">
                    <table id="tblSt" class="table table-striped table-bordered nowrap hover">
                        <thead>
                            <tr>
                                <th>

                                    
                                Loading Factor

                                </th>
                                <th>
                                    Loading %
                                </th>
                                <th>
                                    Burning Premium Loading
                                </th>
                                <th>Enrollment Premium</th>
                            </tr>
                        </thead>
                        <tbody id="tbodySt">
                        </tbody>
                    </table>
                    </div>
                     <div class="row">
                        <div class="form-group col-6" id="idpolicy">
                            <input type="button" id="idST" class="btn btn-primary" value="Calculate" onclick="calculateST();"/>
                            
                        </div>
                    </div>
                    <p style="padding:2px;background-color:maroon;color:white;margin-left: -29px;"><strong><b>Loading Discount Factor</b></strong></p>
                    <div class="table-responsive">
                    <table id="tblFactor" class="table table-striped table-bordered nowrap hover">
                        <thead>
                            <tr>
                                <th>

                                    Factors
                                    
                                </th>
                                <th>
                                    Loading %
                                </th>
                                <th>
                                    Discount %
                                </th>
                                <th>Loading/Discount Amount-burn cost premium</th>
                                <th>Loading/Discount Amount - Enrollment Premium</th>
                                <th>Expiring Limit</th>
