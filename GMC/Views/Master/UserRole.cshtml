@model IEnumerable<GMC.Models.GMC.UserRoleModel>
@{
    ViewData["Title"] = "User Role Master";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="card shadow-sm p-4 bg-white rounded">
    <div class="card-body">
        <h2 class="text-center mb-4" style="color: #034ea2;">User Role Master</h2>
        <form asp-action="UserRole" method="post" class="mb-4">
            <div class="row">
                <div class="col-md-9 form-group">
                    <input type="text" name="roleName" class="form-control" placeholder="Enter new role name..." required />
                </div>
                <div class="col-md-3 form-group">
                    <button type="submit" class="btn btn-primary w-100" style="background-color: #034ea2;">Add Role</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-bordered text-center">
                <thead style="background-color: maroon; color: white;">
                    <tr>
                        <th>Role ID</th>
                        <th>Role Name</th>
                        <th>Is Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td>@role.RoleId</td>
                            <td>@role.RoleName</td>
                            <td>@(role.IsActive ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
