@model IEnumerable<GMC.Models.GMC.FormPermissionModel>
@{
    ViewData["Title"] = "Form Permission Master";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="card shadow-sm p-4 bg-white rounded">
    <div class="card-body">
        <h2 class="text-center mb-4" style="color: #034ea2;">Form Permission Master</h2>
        <form asp-action="FormPermission" method="post" class="mb-5">
            <div class="row mb-3">
                <div class="col-md-4 form-group">
                    <label class="fw-bold">Select Role</label>
                    <select name="RoleId" class="form-select form-control" asp-items="ViewBag.Roles" required>
                        <option value="">-- Select Role --</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="fw-bold">Form Name</label>
                    <input type="text" name="FormName" class="form-control" placeholder="e.g. GMC Uploader" required />
                </div>
                <div class="col-md-4 form-group d-flex align-items-center">
                    <div class="form-check me-4">
                        <input class="form-check-input" type="checkbox" name="CanView" value="true" id="CanView">
                        <label class="form-check-label fw-bold" for="CanView">Can View</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="CanEdit" value="true" id="CanEdit">
                        <label class="form-check-label fw-bold" for="CanEdit">Can Edit</label>
                    </div>
                </div>
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4 py-2" style="background-color: #034ea2;">Add Permission</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-bordered text-center">
                <thead style="background-color: maroon; color: white;">
                    <tr>
                        <th>ID</th>
                        <th>Role Name</th>
                        <th>Form Name</th>
                        <th>Can View</th>
                        <th>Can Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var perm in Model)
                    {
                        <tr>
                            <td>@perm.PermissionId</td>
                            <td>@perm.RoleName</td>
                            <td>@perm.FormName</td>
                            <td>
                                @if (perm.CanView) { <span class="badge bg-success" style="background-color: green;">Yes</span> } 
                                else { <span class="badge bg-danger" style="background-color: red;">No</span> }
                            </td>
                            <td>
                                @if (perm.CanEdit) { <span class="badge bg-success" style="background-color: green;">Yes</span> } 
                                else { <span class="badge bg-danger" style="background-color: red;">No</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
