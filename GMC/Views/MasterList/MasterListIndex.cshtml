@model GMC.Models.GMC.MasterListIndexModel
@{
    Layout = "_LayoutModern";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="gmc-card mb-3">
    <div class="card-body">
        <h5 class="mb-3"><i class="bi bi-list-check me-2"></i>@Model.Title</h5>

        <!-- Add new row -->
        <form method="post" asp-action="@Model.AddAction" class="row g-2 mb-0">
            @Html.AntiForgeryToken()
            <div class="col-sm-9">
                <input type="text" name="name" class="form-control"
                       placeholder="@Model.AddPlaceholder" maxlength="200" required />
            </div>
            <div class="col-sm-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle me-1"></i>Add
                </button>
            </div>
        </form>
    </div>
</div>

<div class="gmc-card">
    <div class="card-body p-0">
        <div class="d-flex align-items-center px-3 pt-3 pb-2">
            <span class="text-muted small">@Model.Items.Count entries</span>
            <input type="text" id="gmcSearch" class="form-control form-control-sm ms-auto"
                   style="max-width:260px" placeholder="Search…" />
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" id="gmcTable">
                <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th>@Model.ItemLabel</th>
                    <th class="text-end" style="width:160px">Actions</th>
                </tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td class="text-muted">@(i + 1)</td>
                        <td class="fw-semibold">@Model.Items[i]</td>
                        <td class="text-end">
                            <a href="@Url.Action(Model.EditAction, new { name = Model.Items[i] })"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" asp-action="@Model.DeleteAction"
                                  style="display:inline"
                                  onsubmit="return confirm('Delete \'@Model.Items[i]\'?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="name" value="@Model.Items[i]" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No records found.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    var input = document.getElementById('gmcSearch');
    var rows  = document.querySelectorAll('#gmcTable tbody tr');
    input.addEventListener('input', function(){
        var q = this.value.toLowerCase();
        rows.forEach(function(r){
            r.style.display = r.textContent.toLowerCase().indexOf(q) >= 0 ? '' : 'none';
        });
    });
})();
</script>
}
