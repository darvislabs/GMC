@model GMC.Models.GMC.EditMasterItemModel
@{
    Layout = "_LayoutModern";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="gmc-card">
            <div class="card-body">
                <h5 class="mb-4"><i class="bi bi-pencil-square me-2"></i>@Model.Title</h5>

                <form method="post" asp-action="@Model.SaveAction">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OldName" />
                    <input type="hidden" asp-for="Title" />
                    <input type="hidden" asp-for="SaveAction" />
                    <input type="hidden" asp-for="CancelAction" />

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Current name</label>
                        <input type="text" class="form-control" value="@Model.OldName" disabled />
                    </div>
                    <div class="mb-4">
                        <label asp-for="NewName" class="form-label fw-semibold">New name</label>
                        <input asp-for="NewName" class="form-control" maxlength="200"
                               autofocus placeholder="Enter updated name…" />
                        <span asp-validation-for="NewName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="@Model.CancelAction" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
