@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LayoutModern";
}
<div class="gmc-card text-center" style="max-width: 540px; margin: 60px auto;">
    <i class="bi bi-shield-lock text-danger" style="font-size: 56px;"></i>
    <h3 class="mt-3">Access Denied</h3>
    <p class="text-muted">Your account does not have permission to view this page. Contact your administrator if you believe this is a mistake.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary mt-2"><i class="bi bi-arrow-left"></i> Back to login</a>
</div>
