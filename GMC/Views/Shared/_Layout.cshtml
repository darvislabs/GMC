@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GMC</title>
    <partial name="_InterFont" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GMC.styles.css" asp-append-version="true" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/commoncss.css" rel="stylesheet" />
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
  
    <script src="@Url.Content("~/js/jquery-3.2.1.min.js")"></script>
    <script src="@Url.Content("~/js/jquery-1.10.2.js")"></script>
    <script src="@Url.Content("~/js/jquery-1.11.1.min.js")"></script>
    <script src="@Url.Content("~/js/datatablesmin.js")"></script>
    <link href="@Url.Content("~/css/jquery.datatables.min.css")" rel="stylesheet" />
    <script src="@Url.Content("~/js/datatables.fixedheader.min.js")"></script>
    <link href="@Url.Content("~/css/buttons.datatables.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/maxcdnbootstrap.min.css")" rel="stylesheet" />
    <script src="@Url.Content("~/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/jquery-ui.js")"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="text-decoration: none; color: inherit; font-size: clamp(20px, 4vw, 30px); font-weight: bold;">
                    <span style="color:red">G</span>MC
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                        var action = ViewContext.RouteData.Values["action"]?.ToString();
                        var isLoginPage = controller == "Account" && action == "Login";
                    }

                    @if (!isLoginPage)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="GMCUploader" asp-action="Index">GMC Uploader</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="GMCCalculatorDetails" asp-action="Index">GMC Calculator Details</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownMaster" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Master
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownMaster">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="UserRegistration">User Registration</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Master" asp-action="UserRole">User Role Master</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Master" asp-action="FormPermission">Form Permission Master</a></li>
                                </ul>
                            </li>
                        </ul>
                    
                        <ul class="navbar-nav">
                            @if (Context.Session.GetString("UserName") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark fw-bold">Hello, @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GMC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
   @*  <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script> *@
    <script src="~/js/jquery.unobtrusive-ajax.js"></script>
 @*   <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script> *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
