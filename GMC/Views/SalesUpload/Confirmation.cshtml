@model GMC.Models.GMC.RolloverUpload
@{
    ViewData["Title"] = "Upload Submitted";
    Layout = "_LayoutModern";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="gmc-card text-center">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 64px;"></i>
            <h3 class="mt-3 mb-1">Upload submitted</h3>
            <p class="text-muted">Reference <strong>#@Model.UploadId</strong> &middot; <span class="gmc-status gmc-status-@Model.Status">@Model.Status</span></p>

            <table class="gmc-table mt-4 text-start">
                <tbody>
                    <tr><th>Policy No</th><td>@Model.PolicyNo</td></tr>
                    <tr><th>Policy Name</th><td>@(Model.PolicyName ?? "—")</td></tr>
                    <tr><th>Insurance Company</th><td>@(Model.InsuranceCompany ?? "—")</td></tr>
                    <tr><th>TPA</th><td>@(Model.TPA ?? "—")</td></tr>
                    <tr><th>File</th><td>@Model.FileName</td></tr>
                    <tr><th>Rows / Columns</th><td>@(Model.TotalRows?.ToString() ?? "?") rows × @(Model.TotalColumns?.ToString() ?? "?") cols</td></tr>
                    <tr><th>Uploaded</th><td>@Model.UploadedOn.ToString("dd MMM yyyy HH:mm")</td></tr>
                </tbody>
            </table>

            <div class="mt-4 d-flex justify-content-center gap-2">
                <a asp-action="MyUploads" class="btn btn-outline-secondary"><i class="bi bi-clock-history"></i> My Uploads</a>
                <a asp-action="Upload" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Upload</a>
            </div>
        </div>
    </div>
</div>
